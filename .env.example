# Copia este archivo a ".env" y completa los valores.
# El archivo .env NO se sube al repositorio (está en .gitignore).

# Conexión a Supabase (PostgreSQL). Consíguela en Supabase:
# Project Settings -> Database -> Connection string (modo URI)
DATABASE_URL=postgresql://usuario:contraseña@host.supabase.com:6543/postgres

# Clave secreta para firmar las cookies de sesión. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=cambia-esta-clave-por-una-aleatoria

# Activa el flag Secure de la cookie de sesión cuando el sitio use https
# (en Vercel actívalo con valor "true" en las variables de entorno).
SESSION_HTTPS_ONLY=false

# Credenciales del administrador inicial (opcional, se crea en create_table.py)
ADMIN_EMAIL=admin@control.com
ADMIN_PASSWORD=admin123
